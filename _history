0\n\nOLED12864_I2C.init(60)\n\n# Get the distance from the sonar and the object in front of it.\ndef get_sonar_distance():\n    value = sonar.ping(SONAR_TRIG_PIN, SONAR_ECHO_PIN, PingUnit.CENTIMETERS)\n    return value\n\n# Write text to the OLED display\ndef screen_write_line(x, y, text):\n    OLED12864_I2C.show_string(x, y, text, 1)\n\n# Rotate selected wheel forward or backward\ndef rotate_wheel(wheel, direction, duration=None):\n    if wheel == WHEEL_RIGHT:\n        pos_pin = MOTOR_RIGHT_POS_PIN\n        neg_pin = MOTOR_RIGHT_NEG_PIN\n    else:\n        pos_pin = MOTOR_LEFT_POS_PIN\n        neg_pin = MOTOR_LEFT_NEG_PIN\n\n    # Set the opposite direction\n    if direction == 0:\n        opp_direction = 1\n    else:\n        opp_direction = 0\n\n    pins.digital_write_pin(pos_pin, direction)\n    pins.digital_write_pin(neg_pin, opp_direction)\n\n    if duration is not None:\n        pause(duration * 1000)\n        pins.digital_write_pin(pos_pin, opp_direction)\n        pins.digital_write_pin(neg_pin, opp_direction)\n\n# Stop selected wheel from turning\ndef stop_wheel(wheel):\n    if wheel == WHEEL_RIGHT:\n        pos_pin = MOTOR_RIGHT_POS_PIN\n        neg_pin = MOTOR_RIGHT_NEG_PIN\n    else:\n        pos_pin = MOTOR_LEFT_POS_PIN\n        neg_pin = MOTOR_LEFT_NEG_PIN\n\n    # Set the opposite direction\n    pins.digital_write_pin(pos_pin, WHEEL_FORWARD)\n    pins.digital_write_pin(neg_pin, WHEEL_FORWARD)\n\n# Stop both wheels from turning\ndef stop_wheels():\n    stop_wheel(WHEEL_RIGHT)\n    stop_wheel(WHEEL_LEFT)\n\n# Move, i.e. two wheels in the same direction\ndef move_wheels(direction, duration=None):\n    rotate_wheel(WHEEL_RIGHT, direction, duration)\n    rotate_wheel(WHEEL_LEFT, direction, duration)\n\n# Turn right\ndef turn_right(duration):\n    rotate_wheel(WHEEL_RIGHT, WHEEL_FORWARD, 0.5)\n    rotate_wheel(WHEEL_RIGHT, WHEEL_BACKWARD, 0.5)\n\nmax_loop = 1\n\nfor loop_num in range(0, max_loop):\n    # Take measurement\n    value = get_sonar_distance()\n\n    # Display measurement\n    text = 'Dist: ' + str(value)\n    screen_write_line(2, 2, text)\n\n    # Sleep for 0.5 second\n    pause(500)\n\n    #rotate_wheel(WHEEL_RIGHT, WHEEL_FORWARD, 0.5)\n    #rotate_wheel(WHEEL_RIGHT, WHEEL_BACKWARD, 0.5)\n    #rotate_wheel(WHEEL_LEFT, WHEEL_FORWARD, 0.5)\n    #rotate_wheel(WHEEL_LEFT, WHEEL_BACKWARD, 0.5)\n    #rotate_wheel(WHEEL_LEFT, WHEEL_BACKWARD)\n    #stop_wheel(WHEEL_LEFT)\n    move_wheels(WHEEL_FORWARD, duration=None):\n\n","pxt.json":"{\n    \"name\": \"Micro Car Sonar\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"OLED12864_I2C\": \"github:makecode-extensions/oled12864_i2c#v1.5.0\",\n        \"pxt-sonar\": \"github:microsoft/pxt-sonar#v0.0.6\",\n        \"pxt-kitronik-move-motor\": \"github:kitronikltd/pxt-kitronik-move-motor#v0.4.20\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\",\n    \"languageRestriction\": \"python-only\"\n}\n"}},{"timestamp":1763671518141,"editorVersion":"8.0.18","text":{"main.ts":"","README.md":"","main.py":"# Input/output pin list\nOPTICAL_SENSOR_RIGHT_PIN = DigitalPin.P0\nOPTICAL_SENSOR_LEFT_PIN  = DigitalPin.P4\nRGB_STRIP_PIN = DigitalPin.P6\nVOLUME_PIN = DigitalPin.P3\nMOTOR_LEFT_POS_PIN = DigitalPin.P13\nMOTOR_LEFT_NEG_PIN = DigitalPin.P14\nMOTOR_RIGHT_POS_PIN = DigitalPin.P15\nMOTOR_RIGHT_NEG_PIN = DigitalPin.P16\nCHASSIS_BUTTON_LEFT_PIN = DigitalPin.P11\nCHASSIS_BUTTON_RIGHT_PIN = DigitalPin.P5\nLINE_SENSOR_LEFT_PIN = DigitalPin.P1\nLINE_SENSOR_RIGHT_PIN = DigitalPin.P2\nSONAR_TRIG_PIN = DigitalPin.P12\nSONAR_ECHO_PIN = DigitalPin.P9\n\n# I2C Address list\nI2C_OLED_ADDR = 60\n\n# Motor wheel constants\nRIGHT = \"RIGHT\"\nLEFT = \"LEFT\"\nWHEEL_FORWARD = 0\nWHEEL_BACKWARD = 1\nWHEEL_STOP = 0\n\nOLED12864_I2C.init(60)\n\n# Get the distance from the sonar and the object in front of it.\ndef get_sonar_distance():\n    value = sonar.ping(SONAR_TRIG_PIN, SONAR_ECHO_PIN, PingUnit.CENTIMETERS)\n    return value\n\n# Write text to the OLED display\ndef screen_write_line(x, y, text):\n    OLED12864_I2C.show_string(x, y, text, 1)\n\n# Rotate selected wheel forward or backward\ndef rotate_wheel(wheel, direction, duration=None):\n    if wheel == RIGHT:\n        pos_pin = MOTOR_RIGHT_POS_PIN\n        neg_pin = MOTOR_RIGHT_NEG_PIN\n    else:\n        pos_pin = MOTOR_LEFT_POS_PIN\n        neg_pin = MOTOR_LEFT_NEG_PIN\n\n    # Set the opposite direction\n    if direction == 0:\n        opp_direction = 1\n    else:\n        opp_direction = 0\n\n    pins.digital_write_pin(pos_pin, direction)\n    pins.digital_write_pin(neg_pin, opp_direction)\n\n    if duration is not None:\n        pause(duration * 1000)\n        pins.digital_write_pin(pos_pin, opp_direction)\n        pins.digital_write_pin(neg_pin, opp_direction)\n\n# Stop selected wheel from turning\ndef stop_wheel(wheel):\n    if wheel == RIGHT:\n        pos_pin = MOTOR_RIGHT_POS_PIN\n        neg_pin = MOTOR_RIGHT_NEG_PIN\n    else:\n        pos_pin = MOTOR_LEFT_POS_PIN\n        neg_pin = MOTOR_LEFT_NEG_PIN\n\n    # Set the opposite direction\n    pins.digital_write_pin(pos_pin, WHEEL_FORWARD)\n    pins.digital_write_pin(neg_pin, WHEEL_FORWARD)\n\n# Stop both wheels from turning\ndef stop_wheels():\n    stop_wheel(RIGHT)\n    stop_wheel(LEFT)\n\n# Move, i.e. two wheels in the same direction\ndef move_wheels(direction, duration=None):\n    rotate_wheel(RIGHT, direction, duration)\n    rotate_wheel(LEFT, direction, duration)\n\n# Turn car\ndef turn_car(direction, duration=None):\n    if direction == RIGHT:\n        rotate_wheel(LEFT, WHEEL_FORWARD)\n        rotate_wheel(RIGHT, WHEEL_BACKWARD)\n    else:\n        rotate_wheel(RIGHT, WHEEL_FORWARD)\n        rotate_wheel(LEFT, WHEEL_BACKWARD)\n\n# Turn \ndef turn_right(duration):\n    rotate_wheel(LEFT, WHEEL_FORWARD)\n    rotate_wheel(RIGHT, WHEEL_BACKWARD)\n\nmax_loop = 1\n\nfor loop_num in range(0, max_loop):\n    # Take measurement\n    value = get_sonar_distance()\n\n    # Display measurement\n    text = 'Dist: ' + str(value)\n    screen_write_line(2, 2, text)\n\n    # Sleep for 0.5 second\n    pause(500)\n\n    #rotate_wheel(RIGHT, WHEEL_FORWARD, 0.5)\n    #rotate_wheel(RIGHT, WHEEL_BACKWARD, 0.5)\n    #rotate_wheel(LEFT, WHEEL_FORWARD, 0.5)\n    #rotate_wheel(LEFT, WHEEL_BACKWARD, 0.5)\n    #rotate_wheel(LEFT, WHEEL_BACKWARD)\n    #stop_wheel(LEFT)\n    move_wheels(WHEEL_FORWARD)\n    pause(2000)\n    stop_wheels()\n    pause(1000)\n    turn_car(RIGHT)\n    pause(1000)\n    stop_wheels()\n    pause(1000)\n    turn_car(LEFT)\n    pause(1000)\n    stop_wheels()\n    pause(1000)\n    move_wheels(WHEEL_BACKWARD)\n    pause(2000)\n    stop_wheels()\n","pxt.json":"{\n    \"name\": \"Micro Car API\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"OLED12864_I2C\": \"github:makecode-extensions/oled12864_i2c#v1.5.0\",\n        \"pxt-sonar\": \"github:microsoft/pxt-sonar#v0.0.6\",\n        \"pxt-kitronik-move-motor\": \"github:kitronikltd/pxt-kitronik-move-motor#v0.4.20\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"main.py\"\n    ],\n    \"preferredEditor\": \"pyprj\",\n    \"languageRestriction\": \"python-only\"\n}\n"}},{"timestamp":1763803012465,"editorVersion":"8.0.18","text":{"main.ts":"","README.md":"","main.py":"# Input/output pin list\nOPTICAL_SENSOR_RIGHT_PIN = DigitalPin.P0\nOPTICAL_SENSOR_LEFT_PIN  = DigitalPin.P4\nRGB_STRIP_PIN = DigitalPin.P6\nVOLUME_PIN = DigitalPin.P3\nMOTOR_LEFT_POS_PIN = DigitalPin.P13\nMOTOR_LEFT_NEG_PIN = DigitalPin.P14\nMOTOR_RIGHT_POS_PIN = DigitalPin.P15\nMOTOR_RIGHT_NEG_PIN = DigitalPin.P16\nCHASSIS_BUTTON_LEFT_PIN = DigitalPin.P11\nCHASSIS_BUTTON_RIGHT_PIN = DigitalPin.P5\nLINE_SENSOR_LEFT_PIN = DigitalPin.P1\nLINE_SENSOR_RIGHT_PIN = DigitalPin.P2\nSONAR_T